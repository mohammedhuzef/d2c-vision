# ==============================================================================
# LaunchTwin AI Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# Never commit .env with real credentials or production secrets.

# --- Database Configuration ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/launchtwin

# --- Core Service & Networking ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Market Research Provider (mock | ai) ---
RESEARCH_PROVIDER=mock

# --- LLM Provider Settings (used when RESEARCH_PROVIDER=ai) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30

# --- Live Page Fetcher Limits & Anti-SSRF ---
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_PAGE_BYTES=1048576
RESEARCH_MAX_TEXT_LENGTH=50000
RESEARCH_MAX_REDIRECTS=3
RESEARCH_USER_AGENT=LaunchTwinBot/1.0 (+https://launchtwin.example.com/bot)

# --- AI Research Guardrails & Quotas ---
RESEARCH_MAX_COMPETITORS=5
RESEARCH_TIME_BUDGET_SECONDS=60
RESEARCH_CONFIDENCE_CAP=0.80
RESEARCH_MAX_EVIDENCE_PER_COMPETITOR=10
RESEARCH_MAX_STRENGTHS=10
RESEARCH_MAX_WEAKNESSES=10
