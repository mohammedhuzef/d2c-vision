# Database configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/launchtwin

# Research Provider (mock | ai)
RESEARCH_PROVIDER=mock

# Application Environment (development | testing | production)
ENVIRONMENT=development

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Configuration (gemini | anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_COMPETITORS=5
