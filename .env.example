# ==============================================================================
# LaunchTwin AI Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# Never commit .env with real credentials or production secrets.

# --- Core Service & Application Metadata ---
PROJECT_NAME=LaunchTwin AI Backend
# Display name of the API service in documentation and headers
VERSION=1.0.0
# Application semantic version
API_V1_PREFIX=/api/v1
# URL routing prefix for v1 business endpoints
DEFAULT_CURRENCY=INR
# Default currency for product pricing and financial validation

# --- Database Configuration ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/launchtwin
# Primary database connection string (PostgreSQL in production, SQLite in development)

# --- Runtime & Security Environments ---
ENVIRONMENT=development
# Runtime environment tier (development, testing, or production)
APP_ENV=development
# Deployment environment tier; alias for ENVIRONMENT
LOG_LEVEL=INFO
# Application logging verbosity (DEBUG, INFO, WARNING, ERROR)
ENABLE_DOCS=true
# Toggle for /docs and /redoc interactive API documentation (disabled in hardened production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Comma-separated list of allowed browser origins (wildcards prohibited in production)

# --- Market Research Provider Mode ---
RESEARCH_PROVIDER=mock
# Market research engine mode: 'mock' for deterministic offline data, 'ai' for live web extraction

# --- LLM Provider Settings (used when RESEARCH_PROVIDER=ai) ---
LLM_PROVIDER=gemini
# AI provider backend service ('gemini' or 'anthropic')
LLM_API_KEY=
# Secret authentication key for Gemini or Anthropic API (never logged or returned)
LLM_MODEL=gemini-1.5-flash
# Target LLM model identifier for evidence extraction
LLM_TIMEOUT_SECONDS=30
# Request timeout in seconds for external LLM inference calls

# --- Live Page Fetcher Limits & Anti-SSRF ---
RESEARCH_FETCH_TIMEOUT_SECONDS=10
# Maximum seconds to wait when fetching a competitor web page
RESEARCH_MAX_PAGE_BYTES=1048576
# Maximum raw HTML payload in bytes allowed when fetching competitor pages (1 MB)
RESEARCH_MAX_TEXT_LENGTH=50000
# Maximum clean text characters extracted from HTML and sent to LLM prompt
RESEARCH_MAX_REDIRECTS=3
# Maximum HTTP redirect hops allowed during web page fetching
RESEARCH_USER_AGENT=LaunchTwinBot/1.0 (+https://launchtwin.example.com/bot)
# User-Agent header identifying the research crawler to target web servers

# --- AI Research Guardrails & Quotas ---
RESEARCH_MAX_COMPETITORS=5
# Maximum number of competitors processed per research run
RESEARCH_TIME_BUDGET_SECONDS=60
# Total execution time budget in seconds allocated per research run
RESEARCH_CONFIDENCE_CAP=0.80
# Upper confidence ceiling assigned to AI-extracted claims and price evidence
RESEARCH_MAX_EVIDENCE_PER_COMPETITOR=10
# Maximum evidence snippets persisted per competitor benchmark
RESEARCH_MAX_STRENGTHS=10
# Maximum competitor strengths extracted per analysis record
RESEARCH_MAX_WEAKNESSES=10
# Maximum competitor weaknesses extracted per analysis record
RESEARCH_STALE_AFTER_SECONDS=900
# Seconds after which an unfinished research run is marked failed as stale (15 minutes)

# --- Abuse & Cost Controls ---
AUTH_ENABLED=false
# Toggle for API authentication gate
APP_API_KEY=
# Secret application API key (empty = unauthenticated)
RATE_LIMIT_ENABLED=false
# Toggle for per-IP rate limiting on expensive POST endpoints (true in production)
RATE_LIMIT_RESEARCH_PER_MINUTE=10
# Maximum research triggers per minute per client IP
RATE_LIMIT_VALIDATE_PER_MINUTE=30
# Maximum validation triggers per minute per client IP
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Maximum requests per minute allowed per client IP when rate limiting is enabled
MAX_REQUEST_BODY_BYTES=1048576
# Maximum allowed HTTP request body size in bytes (1 MB)
